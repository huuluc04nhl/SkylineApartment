# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resident Card HMAC Signing (Server-only, tối thiểu 32 ký tự)
RESIDENT_CARD_SECRET=

# Google Gemini AI (Server-only)
GEMINI_API_KEY=

# VNPay Sandbox / Production (Server-only)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# App & Mode
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
# Số proxy tin cậy đứng trước app (trên Vercel cần đặt TRUSTED_PROXY_COUNT=1; để 0 nếu chạy trực tiếp)
TRUSTED_PROXY_COUNT=0
